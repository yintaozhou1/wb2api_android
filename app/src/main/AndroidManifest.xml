<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 网关地址浮窗（启动网关后在其它应用上层显示 127.0.0.1:端口）。
         权限本身在系统设置页授予（Settings.ACTION_MANAGE_OVERLAY_PERMISSION），
         未授予时浮窗静默不显示，不影响网关主功能。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Android 17（API 37）起，跨应用的 127.0.0.1 / localhost / ::1 通信默认被禁止；
      发送方与接收方**都必须**声明 USE_LOOPBACK_INTERFACE，否则连接返回 EPERM。
      本应用正是「本机网关服务端」这一角色（Claude Code 等客户端连 127.0.0.1），
      所以必须声明。它是**安装期权限**（无运行时弹窗）；targetSdk ≤ 36 时由 INTERNET 隐式授予。
      同一应用内的多进程回环通信不受影响。
    -->
    <uses-permission android:name="android.permission.USE_LOOPBACK_INTERFACE" />

    <!--
      Android 17 起，访问**局域网**改为运行时权限（NEARBY_DEVICES 权限组）。
      本应用默认监听 0.0.0.0，PC 端要用「手机局域网 IP」访问网关 —— 不授权则这条链路在
      Android 17 上会被拒绝（本机回环链路不受影响）。因此声明 + 在「启动网关」时按需申请。
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Android 11+ 包可见性：允许用系统浏览器打开 OAuth 授权页 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!--
      凭据池应用不做云备份：filesDir 下是 auths/*.json（OAuth access/refresh token 明文）
      与 config.json（网关 api_key 明文）。allowBackup=true 会把它们送进 Google 云备份，
      也能被 adb backup 取出 —— 对「持有他人凭据」的应用这是实质泄漏面。
      代价：换机/恢复出厂后需要重新登录并重填密钥（对本应用本就应该如此）。
      配套：res/xml/data_extraction_rules.xml 显式排除全部 domain（API 31+）。
    -->
    <!--
      android:enableOnBackInvokedCallback="true"
        Android 16（API 36）起，targetSdk >= 36 的应用**强制**启用预测式返回：
        系统不再调用 onBackPressed()、也不再派发 KeyEvent.KEYCODE_BACK。
        本应用早已用 Compose 的 BackHandler（走 OnBackPressedDispatcher），本身就是
        官方支持的返回导航 API，因此这里显式声明只是把意图写明，并让 **低版本系统**
        （Android 13~15）也走同一条新路径，避免两套行为。
    -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="34"
        android:theme="@style/Theme.Wb2api">

        <!--
          release 包也允许 shell 侧做性能剖析（perfetto / simpleperf / heap dump）。
          官方推荐：debuggable=false 时默认**不允许**剖析，加这个标签只在「明确
          要求剖析」的场景下放开，不影响正常运行、也不开调试口子。
          本应用有大量自绘玻璃与常驻前台服务，能对线上包直接量测是必要的。
        -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Wb2api"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OAuth 授权页：独立 Activity + 纯 View WebView（脱离 Compose 树，避免输入法打断 WebView 焦点）。 -->
        <activity
            android:name=".LoginWebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Wb2api" />

        <service
            android:name=".service.GatewayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
