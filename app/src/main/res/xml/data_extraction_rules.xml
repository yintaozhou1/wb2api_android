<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31+）的数据提取规则。
  与 manifest 的 allowBackup="false" 配套：这里显式声明「云备份与设备间迁移都不包含任何文件」，
  避免某些 ROM/工具链在不同 Android 版本上对 allowBackup 的解释不一致。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
